<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>NiziKit</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <PackageId>NiziKit</PackageId>
        <Description>A thin managed layer over the DenOfIz graphics library: window management, input, game loop, and graphics helpers (passes, bindings, buffers) for building your own renderer on DirectX12, Vulkan, and Metal.</Description>
    </PropertyGroup>

    <!-- dotnet build -p:DenOfIzSource=Local builds against the DenOfIz checkout at $(DenOfIzRoot) -->
    <PropertyGroup>
        <DenOfIzSource Condition="'$(DenOfIzSource)' == ''">NuGet</DenOfIzSource>
        <DenOfIzGraphicsVersion Condition="'$(DenOfIzGraphicsVersion)' == ''">1.2.0</DenOfIzGraphicsVersion>
        <DenOfIzRoot Condition="'$(DenOfIzRoot)' == ''">$(MSBuildThisFileDirectory)../../DenOfIz</DenOfIzRoot>
        <DenOfIzLocalBuildDir Condition="'$(DenOfIzLocalBuildDir)' == ''">$(DenOfIzRoot)/build/DenOfIz/Install_OSX</DenOfIzLocalBuildDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(DenOfIzSource)' == 'NuGet'">
        <PackageReference Include="DenOfIzGraphics" Version="$(DenOfIzGraphicsVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(DenOfIzSource)' == 'Local'">
        <ProjectReference Include="$(DenOfIzRoot)/Bindings/CSharp/DenOfIzGraphicsCSharp.csproj" SetTargetFramework="TargetFramework=net8.0" />
        <None Include="$(DenOfIzLocalBuildDir)/Graphics/Release/*.dylib;$(DenOfIzLocalBuildDir)/*.dylib" Visible="false" Pack="false" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
      <None Include="build\NiziKit.props" Pack="true" PackagePath="build\;buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="UI\Fonts\*.ttf">
        <LogicalName>NiziKit.UI.Fonts.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

</Project>
